# Copie este arquivo para .env e substitua somente no ambiente privado.
# Nunca envie .env, chaves, tokens ou identificadores reais ao Git.

ALLOWED_ORIGINS=https://focusflow.example.com
REQUIRE_ACCESS_AUTH=true
TEAM_DOMAIN=https://your-team.cloudflareaccess.com
POLICY_AUD=replace-with-your-cloudflare-access-audience

# Opcional: use apenas durante a migração de dados legados.
LEGACY_OWNER_EMAIL=

# Destino opcional para `npm run updates:publish`.
FOCUSFLOW_UPDATE_HOST=deploy@example-host
FOCUSFLOW_UPDATE_REMOTE_DIR=/srv/focusflow/updates
