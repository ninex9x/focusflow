{
  "name": "focusflow",
  "version": "1.4.4",
  "description": "Controle de tempo com sincronização segura pelo backend FocusFlow.",
  "author": {
    "name": "FocusFlow contributors",
    "email": "170105990+ninex9x@users.noreply.github.com"
  },
  "homepage": "https://github.com/ninex9x/focusflow",
  "desktopName": "FocusFlow",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:web": "node scripts/serve.mjs",
    "start": "node server/index.mjs",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:dev": "electron .",
    "desktop:icon": "node scripts/generate-desktop-icon.mjs",
    "desktop:dir": "electron-builder --dir",
    "desktop:windows": "electron-builder --win nsis --publish never",
    "desktop:linux": "electron-builder --linux AppImage deb --publish never",
    "updates:prepare": "node scripts/prepare-updates.mjs",
    "updates:publish": "node scripts/publish-updates.mjs"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "electron@43.4.0": true
  },
  "build": {
    "appId": "com.focusflow.app",
    "productName": "FocusFlow",
    "artifactName": "FocusFlow-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
