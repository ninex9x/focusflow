<resources>
    <style name="Theme.FocusFlow" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/focusflow_background</item>
        <item name="android:colorAccent">@color/focusflow_primary</item>
        <item name="android:statusBarColor">@color/focusflow_background</item>
        <item name="android:navigationBarColor">@color/focusflow_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
